{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shittysites-template",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shittysites-template",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "shittysites-template-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "shittysites-template-CACHE",
		},
		{
			"binding": "shittysites-template-SESSION",
		},
	],
	// Worker Loader — sandbox/isolate plugins only; not on Workers Free. Template uses native plugins (`format: "native"`).
	// "worker_loaders": [
	// 	{
	// 		"binding": "LOADER",
	// 	},
	// ],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
