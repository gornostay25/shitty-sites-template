{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shittysites-template",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shittysites-template",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "shittysites-template-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "54198a915d184371b822199afec552da",
			"preview_id": "aa675bd3e8814dee96b7a143599f641a",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// General maintenance cron trigger — no dedicated media usage cron (removed in EmDash 0.36)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
