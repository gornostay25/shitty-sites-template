{
  "name": "app",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "ShittySites Template",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
