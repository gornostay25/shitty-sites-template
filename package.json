    "@floating-ui/react": "^0.27.16",
    "astro": "7.3.2",
    "emdash": "^0.37.0",
    "modern-screenshot": "^4.6.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.4.2",
    "@types/sanitize-html": "^2.16.0",
