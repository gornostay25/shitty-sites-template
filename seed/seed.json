{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "ShittySites Template",
		"description": "Agency base template — full EmDash reference, unstyled on purpose",
		"author": "EmDash"
	},
	"settings": {
		"title": "ShittySites Demo",
		"tagline": "Full EmDash capability reference — unstyled on purpose",
		"url": "http://localhost:4321",
		"postsPerPage": 5,
		"dateFormat": "MMMM d, yyyy",
		"timezone": "UTC",
		"social": {
			"twitter": "shittysites",
			"github": "example"
		},
		"seo": {
			"titleSeparator": " | ",
			"robotsTxt": null,
			"googleVerification": "",
			"bingVerification": ""
		}
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"commentsEnabled": true,
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image",
					"options": {
						"darkVariant": true
					}
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "template",
					"label": "Page Template",
					"type": "select",
					"defaultValue": "Default",
					"validation": {
						"options": ["Default", "Full Width", "Sidebar"]
					}
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "showcase",
			"label": "Showcase",
			"labelSingular": "Showcase Entry",
			"urlPattern": "/showcase/{slug}",
			"supports": ["drafts", "revisions", "search"],
			"hidden": true,
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "field_string",
					"label": "String",
					"type": "string"
				},
				{
					"slug": "field_text",
					"label": "Text",
					"type": "text",
					"options": {
						"rows": 4
					}
				},
				{
					"slug": "field_url",
					"label": "URL",
					"type": "url"
				},
				{
					"slug": "field_number",
					"label": "Number",
					"type": "number"
				},
				{
					"slug": "field_integer",
					"label": "Integer",
					"type": "integer"
				},
				{
					"slug": "field_boolean",
					"label": "Boolean",
					"type": "boolean"
				},
				{
					"slug": "field_datetime",
					"label": "Datetime",
					"type": "datetime"
				},
				{
					"slug": "field_select",
					"label": "Select",
					"type": "select",
					"validation": {
						"options": ["alpha", "beta", "gamma"]
					}
				},
				{
					"slug": "field_multi_select",
					"label": "Multi Select",
					"type": "multiSelect",
					"validation": {
						"options": ["red", "green", "blue"]
					}
				},
				{
					"slug": "field_portable_text",
					"label": "Portable Text",
					"type": "portableText"
				},
				{
					"slug": "field_image",
					"label": "Image",
					"type": "image",
					"options": {
						"darkVariant": true
					}
				},
				{
					"slug": "field_file",
					"label": "File",
					"type": "file"
				},
				{
					"slug": "field_reference",
					"label": "Reference",
					"type": "reference",
					"options": {
						"collection": "pages"
					}
				},
				{
					"slug": "field_json",
					"label": "JSON",
					"type": "json"
				},
				{
					"slug": "field_slug",
					"label": "Slug",
					"type": "slug"
				},
				{
					"slug": "field_repeater",
					"label": "Repeater",
					"type": "repeater",
					"validation": {
						"subFields": [
							{
								"slug": "label",
								"label": "Label",
								"type": "string"
							},
							{
								"slug": "value",
								"label": "Value",
								"type": "string"
							}
						],
						"maxItems": 6
					}
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "emdash",
					"label": "EmDash",
					"description": "EmDash platform topics"
				},
				{
					"slug": "guides",
					"label": "Guides",
					"parent": "emdash",
					"description": "How-to guides and walkthroughs"
				},
				{
					"slug": "reference",
					"label": "Reference",
					"parent": "emdash",
					"description": "Capability reference material"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{ "slug": "welcome", "label": "Welcome" },
				{ "slug": "demo", "label": "Demo" },
				{ "slug": "seo", "label": "SEO" },
				{ "slug": "dark-mode", "label": "Dark Mode" },
				{ "slug": "comments", "label": "Comments" }
			]
		},
		{
			"name": "service-area",
			"label": "Service Areas",
			"labelSingular": "Service Area",
			"hierarchical": false,
			"collections": ["pages"],
			"terms": [
				{ "slug": "local", "label": "Local" },
				{ "slug": "remote", "label": "Remote" },
				{ "slug": "nationwide", "label": "Nationwide" }
			]
		}
	],
	"bylines": [
		{
			"id": "editorial",
			"slug": "shittysites-editorial",
			"displayName": "ShittySites Editorial",
			"bio": "The ShittySites template editorial team."
		},
		{
			"id": "guest-author",
			"slug": "guest-contributor",
			"displayName": "Guest Contributor",
			"isGuest": true,
			"bio": "Occasional guest author for demo multi-byline posts."
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "collection",
					"label": "Posts",
					"collection": "posts"
				},
				{
					"type": "page",
					"ref": "about"
				},
				{
					"type": "post",
					"ref": "welcome",
					"label": "Welcome Post"
				},
				{
					"type": "taxonomy",
					"label": "Guides",
					"ref": "guides",
					"collection": "category"
				},
				{
					"type": "custom",
					"label": "More",
					"url": "#",
					"children": [
						{
							"type": "custom",
							"label": "Feature Guide",
							"url": "/feature-guide"
						},
						{
							"type": "custom",
							"label": "Showcase",
							"url": "/showcase/all-fields"
						},
						{
							"type": "page",
							"ref": "contact",
							"label": "Contact"
						},
						{
							"type": "custom",
							"label": "Search",
							"url": "/search"
						}
					]
				}
			]
		},
		{
			"name": "footer",
			"label": "Footer Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Posts",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "Search",
					"url": "/search"
				},
				{
					"type": "page",
					"ref": "about"
				},
				{
					"type": "page",
					"ref": "feature-guide",
					"label": "Feature Guide"
				},
				{
					"type": "page",
					"ref": "contact"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/old-about",
			"destination": "/about",
			"type": 301
		},
		{
			"source": "/blog",
			"destination": "/posts",
			"type": 308
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Widget area on post detail and Sidebar page layout",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search",
					"props": {
						"placeholder": "Search posts and pages…"
					}
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories",
					"props": {
						"showCount": true,
						"hierarchical": true
					}
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5,
						"showDate": true
					}
				},
				{
					"type": "component",
					"componentId": "core:tags",
					"title": "Tags",
					"props": {
						"showCount": true,
						"limit": 20
					}
				},
				{
					"type": "component",
					"componentId": "core:archives",
					"title": "Archives",
					"props": {
						"type": "monthly",
						"limit": 6
					}
				},
				{
					"type": "content",
					"title": "About this demo",
					"content": [
						{
							"_type": "block",
							"_key": "sidebar-about",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "sidebar-about-span",
									"text": "ShittySites is an unstyled EmDash reference. Fork agents delete unused seed sections together with matching routes.",
									"marks": []
								}
							]
						}
					]
				},
				{
					"type": "menu",
					"title": "Quick Links",
					"menuName": "footer"
				}
			]
		},
		{
			"name": "footer",
			"label": "Footer",
			"description": "Footer widget area in SiteFooter",
			"widgets": [
				{
					"type": "content",
					"title": "ShittySites Demo",
					"content": [
						{
							"_type": "block",
							"_key": "footer-tagline",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "footer-tagline-span",
									"text": "Full EmDash capability reference — unstyled on purpose. Set site URL in Settings before deploy.",
									"marks": []
								}
							]
						}
					]
				},
				{
					"type": "menu",
					"title": "Footer Menu",
					"menuName": "footer"
				}
			]
		}
	],
