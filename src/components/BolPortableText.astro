---
import { PortableText } from "emdash/ui";
import type { PortableTextProps } from "astro-portabletext";
import HtmlBlock from "./HtmlBlock.astro";
import { blockComponents } from "../plugins/bol-theme/astro/index.ts";

interface Props extends Omit<PortableTextProps, "value"> {
	value: PortableTextProps["value"];
}

const { value, components, ...rest } = Astro.props;

const typeComponents = {
	...blockComponents,
	htmlBlock: HtmlBlock,
	...(components?.type ?? {}),
};
---

<PortableText value={value} components={{ ...components, type: typeComponents }} {...rest} />
