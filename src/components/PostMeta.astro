---
import type { ContentEntry } from "emdash";
import type { Post } from "../../emdash-env";
import type { SiteIdentity } from "../utils/site-identity";

interface Props {
	post: ContentEntry<Post>;
	identity: SiteIdentity;
}

const { post, identity } = Astro.props;

function formatDate(date: Date | null | undefined): string | null {
	if (!date) return null;
	return date.toLocaleDateString("en-US", {
		timeZone: identity.timezone,
		year: "numeric",
		month: "long",
		day: "numeric",
	});
}

const published = formatDate(post.data.publishedAt);
const { byline, bylines } = post.data;
---

<footer>
	{published && post.data.publishedAt && (
		<time datetime={post.data.publishedAt.toISOString()}>{published}</time>
	)}

	{byline && (
		<p>
			<span>{byline.displayName}</span>
		</p>
	)}

	{
		bylines?.map((credit) => (
			<p>
				<span>{credit.byline.displayName}</span>
				{credit.roleLabel && <span> ({credit.roleLabel})</span>}
			</p>
		))
	}
</footer>
