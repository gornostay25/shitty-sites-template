---
import { Font } from "astro:assets";
import { getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import type { SeoMeta } from "emdash";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { resolveSiteIdentity } from "../utils/site-identity";

interface Props extends SeoMeta {
	content?: {
		collection: string;
		id: string;
		slug: string;
	};
}

const { content, ...seo } = Astro.props;
const settings = await getSiteSettings();
const identity = resolveSiteIdentity(settings);
const locale = Astro.currentLocale ?? "en";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: content ? "article" : "website",
	title: seo.title,
	pageTitle: seo.title,
	description: seo.description ?? identity.siteTagline,
	canonical: seo.canonical ?? Astro.url.href,
	image: seo.ogImage ?? undefined,
	content,
	siteName: identity.siteTitle,
});
---

<!doctype html>
<html lang={locale} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-display-src" preload />
		<Font cssVariable="--font-body-src" preload />
		<SeoHead {...seo} />
		<EmDashHead page={pageCtx} />
	</head>
	<body class="antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-md focus:bg-brand focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#1c1305]"
		>
			Skip to content
		</a>

		<SiteHeader identity={identity} />

		<main
			id="main-content"
			class="pb-[calc(5.5rem+env(safe-area-inset-bottom))] md:pb-0"
		>
			<slot />
		</main>

		<SiteFooter identity={identity} />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
