---
import { getEmDashCollection, getTaxonomyTerms } from "emdash";
import { getPtNode } from "../../utils/pt-node.ts";
import type { BolMenuNode } from "../../types/pt-blocks.ts";
import { formatHUF } from "../../utils/format.ts";
import { flattenCategoryTerms } from "../../utils/taxonomy.ts";
import { MENU_CATEGORY_TAXONOMY } from "../../types/taxonomies.ts";
import MenuTabsEnhancer from "../components/MenuTabsEnhancer.astro";

const node = getPtNode<BolMenuNode>(Astro.props);
const { eyebrow, title, subtitle, footnote } = node;
const locale = Astro.currentLocale ?? "en";
const menuTitle = title ?? "Menu";

const categoryTerms = flattenCategoryTerms(
	await getTaxonomyTerms(MENU_CATEGORY_TAXONOMY),
);

const categoryResults = await Promise.all(
	categoryTerms.map((term) =>
		getEmDashCollection("menu_items", {
			locale,
			where: { menu_category: term.slug },
			orderBy: { sort_order: "asc" },
		}),
	),
);

for (const result of categoryResults) {
	if (Astro.cache?.enabled && result.cacheHint) {
		Astro.cache.set(result.cacheHint);
	}
}

const tabLabels = Object.fromEntries(
	categoryTerms.map((term) => [term.slug, term.label]),
);

const itemsByCategory = Object.fromEntries(
	categoryTerms.map((term, index) => [
		term.slug,
		categoryResults[index]?.entries.map((entry) => ({
			id: entry.id,
			name: entry.data.name,
			description: entry.data.description,
			price: entry.data.price,
			image: entry.data.image,
		})) ?? [],
	]),
);
---

<section
	id="menu"
	aria-labelledby="menu-title"
	class="scroll-mt-20 mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 md:py-24"
>
	{eyebrow && (
		<p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand">{eyebrow}</p>
	)}
	{
		title && (
			<h2 id="menu-title" class="mt-3 font-display text-4xl tracking-wide sm:text-5xl">
				{title}
			</h2>
		)
	}
	{
		subtitle && (
			<p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">
				{subtitle}
			</p>
		)
	}

	<div class="menu-tabs mt-10">
		<div
			role="tablist"
			aria-label={menuTitle}
			class="scrollbar-slim -mx-1 flex gap-1 overflow-x-auto rounded-full border border-border bg-surface p-1 sm:mx-0 sm:inline-flex sm:w-auto sm:overflow-visible"
		>
			{
				categoryTerms.map((term, index) => (
					<button
						type="button"
						role="tab"
						id={`menu-tab-${term.slug}`}
						aria-selected={index === 0 ? "true" : "false"}
						aria-controls={`menu-panel-${term.slug}`}
						tabindex={index === 0 ? 0 : -1}
						class="menu-tab-btn inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent px-4 font-[inherit] text-sm font-semibold transition-colors sm:px-6"
						data-tab={term.slug}
					>
						{tabLabels[term.slug] ?? term.slug}
					</button>
				))
			}
		</div>

		{
			categoryTerms.map((term, index) => (
				<div
					id={`menu-panel-${term.slug}`}
					role="tabpanel"
					aria-labelledby={`menu-tab-${term.slug}`}
					tabindex={index === 0 ? 0 : undefined}
					class="menu-tab-panel mt-8"
					hidden={index !== 0}
				>
					<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{
							(itemsByCategory[term.slug] ?? []).map((item) => (
								<li class="group overflow-hidden rounded-card border border-border bg-surface transition-all duration-300 hover:border-brand/40 hover:shadow-glow">
									<div class="relative aspect-4/3 overflow-hidden">
										{
											item.image?.src ? (
												<img
													src={item.image.src}
													alt={item.image.alt ?? item.name}
													width={item.image.width}
													height={item.image.height}
													loading="lazy"
													class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
												/>
											) : (
												<div class="grid size-full place-items-center bg-surface-2 text-muted-foreground">
													<span class="text-sm">No image</span>
												</div>
											)
										}
										<span class="absolute right-3 top-3 rounded-full bg-background/90 px-3 py-1.5 font-display text-lg tracking-wide text-brand backdrop-blur">
											{formatHUF(item.price, locale)}
										</span>
									</div>
									<div class="p-4">
										<h3 class="font-display text-2xl tracking-wide">{item.name}</h3>
										{
											item.description && (
												<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
													{item.description}
												</p>
											)
										}
									</div>
								</li>
							))
						}
					</ul>
				</div>
			))
		}

		{footnote && <p class="mt-6 text-xs text-muted-foreground">{footnote}</p>}
	</div>
</section>

<style is:global>
	.menu-tabs .menu-tab-panel[hidden] {
		display: none;
	}

	.menu-tab-btn[aria-selected="true"] {
		background-color: var(--color-brand);
		color: #1c1305;
	}

	.menu-tab-btn {
		color: var(--color-muted-foreground);
	}

	.menu-tab-btn:hover {
		color: var(--color-foreground);
	}
</style>

<MenuTabsEnhancer />
