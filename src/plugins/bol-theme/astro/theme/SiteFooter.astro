---
import Icon from "../icons/Icon.astro";
import { getUiStrings } from "../../utils/i18n/index.ts";
import { socialLinksFromVenue } from "../../utils/socials.ts";
import type { PublicVenueSettings } from "../../utils/venue.ts";

interface Props {
	locale: string;
	venue: PublicVenueSettings;
}

const { locale, venue } = Astro.props;
const ui = getUiStrings(locale);
const year = new Date().getFullYear();
const rights = ui.footer.rightsTpl.replace("{year}", String(year));

const socials = socialLinksFromVenue(venue);
---

<footer class="border-t border-border bg-surface/40">
	<div class="mx-auto w-full max-w-6xl px-4 pb-[calc(5.5rem+env(safe-area-inset-bottom))] pt-12 sm:px-6 md:pb-10">
		<div class="grid gap-10 md:grid-cols-2">
			<div>
				<p class="font-display text-2xl tracking-wider">
					<span class="text-foreground">BAR OF </span>
					<span class="text-brand">LEGENDS</span>
				</p>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">
					{ui.footer.tagline}
				</p>
				<p class="mt-5 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
					{ui.footer.followUs}
				</p>
				<div class="mt-3 flex gap-2">
					{
						socials.map((social) => (
							<a
								href={social.href}
								aria-label={ui.contact.socials[social.id]}
								class="grid size-12 place-items-center rounded-lg border border-border bg-surface text-muted-foreground transition-colors hover:border-brand/40 hover:text-brand"
							>
								<Icon name={social.id} />
							</a>
						))
					}
				</div>
			</div>

			<div>
				<h2 class="font-display text-xl tracking-wide">{ui.footer.contactTitle}</h2>
				<ul class="mt-4 space-y-4 text-sm">
					<li class="flex items-start gap-3 text-muted-foreground">
						<Icon name="map-pin" class="mt-0.5 size-4 shrink-0 text-brand" />
						<span>{venue.address}</span>
					</li>
					<li class="flex items-start gap-3">
						<Icon name="mail" class="mt-0.5 size-4 shrink-0 text-brand" />
						<a
							href={`mailto:${venue.email}`}
							class="break-all text-muted-foreground transition-colors hover:text-brand"
						>
							{venue.email}
						</a>
					</li>
					<li class="flex items-start gap-3">
						<Icon name="phone" class="mt-0.5 size-4 shrink-0 text-brand" />
						<a
							href={`tel:${venue.phoneTel}`}
							class="text-muted-foreground transition-colors hover:text-brand"
						>
							{venue.phoneDisplay}
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-10 border-t border-white/5 pt-6 text-center text-xs text-muted-foreground">
			{rights}
		</div>
	</div>
</footer>
