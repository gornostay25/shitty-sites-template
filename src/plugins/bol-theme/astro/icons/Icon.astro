---
import {
	Beer,
	CalendarCheck,
	ChevronRight,
	Clock,
	Gamepad2,
	Mail,
	MapPin,
	Menu,
	Phone,
	Users,
	X,
} from "@lucide/astro";

const LUCIDE_ICONS = {
	beer: Beer,
	"calendar-check": CalendarCheck,
	"chevron-right": ChevronRight,
	clock: Clock,
	gamepad2: Gamepad2,
	mail: Mail,
	"map-pin": MapPin,
	menu: Menu,
	phone: Phone,
	users: Users,
	x: X,
} as const;

const BRAND_ICONS = ["instagram", "facebook", "tiktok"] as const;
type BrandIconName = (typeof BRAND_ICONS)[number];
type LucideIconName = keyof typeof LUCIDE_ICONS;
export type IconName = LucideIconName | BrandIconName;

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = "size-5" } = Astro.props;
const LucideIcon = name in LUCIDE_ICONS ? LUCIDE_ICONS[name as LucideIconName] : null;

const brandStroke = {
	fill: "none",
	stroke: "currentColor",
	"stroke-width": "2",
	"stroke-linecap": "round",
	"stroke-linejoin": "round",
} as const;
---

{
	LucideIcon && <LucideIcon class={className} aria-hidden="true" />
}
{
	name === "instagram" && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true" {...brandStroke}>
			<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
			<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
			<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
		</svg>
	)
}
{
	name === "facebook" && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true" {...brandStroke}>
			<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
		</svg>
	)
}
{
	name === "tiktok" && (
		<svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
			<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
		</svg>
	)
}
