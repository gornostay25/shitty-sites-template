---
/**
 * Route: /tag/{slug}
 * Features: flat taxonomy archive
 * Admin: Content → Taxonomies → Tags
 * Docs: https://docs.emdashcms.com/guides/taxonomies/
 * Fork: delete with tag taxonomy if unused
 */
import { getEmDashCollection, getSiteSettings, getTerm } from "emdash";
import Base from "../../layouts/Base.astro";
import { resolveSiteIdentity } from "../../utils/site-identity";
import { buildStaticPageSeo } from "../../utils/seo";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const term = await getTerm("tag", slug);
if (!term) return Astro.redirect("/404");

const settings = await getSiteSettings();
const identity = resolveSiteIdentity(settings);
const seo = buildStaticPageSeo({
	title: term.label,
	path: `/tag/${slug}`,
	identity,
});

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base {...seo}>
	<article>
		<h1>#{term.label}</h1>
		{
			posts.length === 0 ? (
				<p>No posts with this tag.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			)
		}
	</article>
</Base>
