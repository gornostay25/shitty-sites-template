---
/**
 * Route: /{slug} (e.g. /about, /feature-guide, /contact)
 * Features: page layout map, PortableText (+ auto plugin blocks), preview, visual editing
 * Admin: Content → Pages
 * Docs: https://docs.emdashcms.com/guides/querying-content/
 * Fork: delete unused templates and trim pages collection in seed
 */
import { getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PageDefault from "../layouts/PageDefault.astro";
import PageFullWidth from "../layouts/PageFullWidth.astro";
import PageSidebar from "../layouts/PageSidebar.astro";
import HtmlBlock from "../components/HtmlBlock.astro";
import { resolveSiteIdentity } from "../utils/site-identity";
import { buildContentSeo } from "../utils/seo";
import type { PageTemplate } from "../types/content";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: page, isPreview, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.redirect("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const settings = await getSiteSettings();
const identity = resolveSiteIdentity(settings);
const seo = buildContentSeo({
	entry: page,
	path: `/${slug}`,
	identity,
});

const layouts = {
	Default: PageDefault,
	"Full Width": PageFullWidth,
	Sidebar: PageSidebar,
} satisfies Record<PageTemplate, typeof PageDefault>;

const template = page.data.template;
const Layout = template ? layouts[template] : PageDefault;
---

<Base
	{...seo}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	{isPreview && (
		<p role="status">Preview mode — unpublished changes may be visible.</p>
	)}

	<Layout>
		<h1 {...page.edit.title}>{page.data.title}</h1>
		{
			page.data.content && (
				<div {...page.edit.content}>
					<PortableText
						value={page.data.content}
						components={{ type: { htmlBlock: HtmlBlock } }}
					/>
				</div>
			)
		}
	</Layout>
</Base>
