---
/**
 * Route: /{slug}
 * CMS pages — single full-width layout, Portable Text (+ plugin blocks).
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { getEmDashEntry, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import BolPortableText from "../components/BolPortableText.astro";
import { resolveSiteIdentity } from "../utils/site-identity";
import { buildContentSeo } from "../utils/seo";
import {
	getRequestLocale,
	isNonDefaultLocale,
	notFoundPath,
} from "../plugins/bol-theme/utils/i18n/index.ts";

const { slug } = Astro.params;
if (slug && isNonDefaultLocale(slug)) {
	const normalized = Astro.url.pathname.replace(/\/$/, "") || "/";
	if (normalized === `/${slug}`) {
		return Astro.redirect(getRelativeLocaleUrl(slug, "/"), 301);
	}
}
if (!slug) return Astro.redirect(notFoundPath(Astro.currentLocale));

if (slug === "home") {
	const requestLocale = getRequestLocale(Astro.originPathname);
	return Astro.redirect(getRelativeLocaleUrl(requestLocale, "/"), 301);
}

const locale = Astro.currentLocale;
const { entry: page, isPreview, cacheHint } = await getEmDashEntry("pages", slug, {
	locale,
});
if (!page) return Astro.redirect(notFoundPath(Astro.currentLocale));

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const settings = await getSiteSettings();
const identity = resolveSiteIdentity(settings);
const seo = buildContentSeo({
	entry: page,
	path: `/${slug}`,
	identity,
});
---

<Base
	{...seo}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	{isPreview && (
		<p role="status" class="mx-auto max-w-6xl px-4 pt-4 text-sm text-brand">
			Preview mode — unpublished changes may be visible.
		</p>
	)}

	<article>
		<h1 {...page.edit.title}>{page.data.title}</h1>
		{
			page.data.content && (
				<div {...page.edit.content}>
					<BolPortableText value={page.data.content} />
				</div>
			)
		}
	</article>
</Base>
